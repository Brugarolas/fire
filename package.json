{
    "name": "napalm-lang",
    "version": "0.1.0",
    "description": "Implementation of Napalm scripting programming language.",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "cargo::run": "cargo run -- scripts/index.napalm",
        "cargo::run::file": "RUSTFLAGS=\" -Awarnings\" cargo run > log.txt 2>&1 -- scripts/index.napalm",
        "cargo::run::server": "RUSTFLAGS=\" -Awarnings\" cargo run > log.txt 2>&1 -- scripts/server.napalm",
        "cargo::run::no_debug": "RUSTFLAGS=\"-C debug-assertions=no -Awarnings\" cargo run -- scripts/index.napalm",
        "cargo::run::classes": "RUSTFLAGS=\"-Awarnings\" cargo run > log.txt 2>&1 -- scripts/classes.napalm",
        "cargo::run::imports": "RUSTFLAGS=\"-Awarnings\" cargo run > log.txt 2>&1 -- scripts/import.napalm",
        "cargo::run::lev": "RUSTFLAGS=\"-Awarnings\" cargo run > log.txt 2>&1 -- scripts/lev.napalm",
        "cargo::run::map": "RUSTFLAGS=\"-Awarnings\" cargo run > log.txt 2>&1 -- scripts/map.napalm",
        "cargo::run::spread": "RUSTFLAGS=\"-Awarnings\" cargo run > log.txt 2>&1 -- scripts/spread.napalm",
        "cargo::run::bool": "RUSTFLAGS=\"-Awarnings\" cargo run > log.txt 2>&1 -- scripts/bool.napalm",
        "cargo::run::proxy": "RUSTFLAGS=\"-Awarnings\" cargo run > log.txt 2>&1 -- scripts/proxy.napalm",
        "cargo::run::error": "RUSTFLAGS=\"-Awarnings\" cargo run > log.txt 2>&1 -- scripts/error.napalm",
        "cargo::perf::fib": "RUSTFLAGS=\"-Awarnings\" cargo run > log.txt 2>&1 -- perf/fib.napalm",
        "cargo::perf::trees": "RUSTFLAGS=\"-Awarnings\" cargo run > log.txt 2>&1 -- perf/trees.napalm",
        "cargo::perf::lev": "RUSTFLAGS=\"-Awarnings\" cargo run > log.txt 2>&1 -- perf/lev.napalm",
        "node::perf::fib": "node perf/fib.js",
        "node::perf::trees": "node perf/trees.js",
        "node::perf::lev": "node perf/lev.js",
        "py::perf::trees": "python perf/trees.py",
        "cargo::build": "RUSTFLAGS=\"-Awarnings\" cargo build --release"
    },
    "author": "Andrés Brugarolas Martínez",
    "license": "MIT"
}
